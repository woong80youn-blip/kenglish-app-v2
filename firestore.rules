rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Nicknames are public so the login screen can offer the requested picker.
    match /publicProfiles/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nickname', 'loginId', 'createdAt'])
        && request.resource.data.nickname is string;
      allow update, delete: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/progress/{document} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // This collection stores nickname plus aggregate percentage only for the home ranking.
    match /publicStats/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nickname', 'overall', 'updatedAt']);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
